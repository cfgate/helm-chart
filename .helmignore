# Patterns to ignore when building packages.
.DS_Store
# Common VCS dirs
.git
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# CI/CD
ci/
.github/
# Local release output must never be repackaged into the chart.
dist/
# Helm
.helmignore
